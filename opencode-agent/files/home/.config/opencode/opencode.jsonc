{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4-flash-free",
  "small_model": "opencode/deepseek-v4-flash-free",
  "provider": {
    "deepseek": {
      "options": {
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash"
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro"
        }
      }
    },
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      },
      "models": {
        "~anthropic/claude-sonnet-latest": {
          "name": "Claude Sonnet (OpenRouter)"
        },
        "~google/gemini-flash-latest": {
          "name": "Gemini Flash (OpenRouter)"
        }
      }
    },
    "google": {
      "options": {
        "apiKey": "{env:GOOGLE_GENERATIVE_AI_API_KEY}"
      },
      "models": {
        "gemini-3.5-flash": {
          "name": "Gemini 3.5 Flash"
        },
        "gemini-3-flash": {
          "name": "Gemini 3 Flash"
        },
        "gemini-3-pro": {
          "name": "Gemini 3 Pro"
        }
      }
    }
  },
  "permission": {
    "idea_*": "deny",
    "idea_execute_run_configuration": "ask",
    "idea_analyze_calls": "allow",
    "idea_fetch_query_result": "allow",
    "idea_generate_*": "allow",
    "idea_get_*": "allow",
    "idea_git_status": "allow",
    "idea_introspect_schema": "allow",
    "idea_lint_files": "allow",
    "idea_list_*": "allow",
    "idea_preview_table_data": "allow",
    "idea_read*": "allow",
    "idea_run_inspection_kts": "allow",
    "idea_search_*": "allow",
    "idea_skill_search": "allow",
    "idea_test_database_connection": "allow",
    "idea_validate_inspection_kts": "allow",
    "idea_xdebug_get_*": "allow",
    "idea_xdebug_list_*": "allow"
  },
  "mcp": {
    "idea": {
      "type": "remote",
      "url": "http://host.docker.internal:64342/sse",
      "headers": {}
    }
  }
}