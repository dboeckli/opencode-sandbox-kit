{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-flash",
  "small_model": "deepseek/deepseek-flash",
  "provider": {
    "deepseek": {
      "options": {
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      },
      "models": {
        "deepseek-flash": {
          "name": "DeepSeek V4.1 Flash"
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro"
        },
        "deepseek-chat": {
          "name": "DeepSeek Chat"
        },
        "deepseek-reasoner": {
          "name": "DeepSeek Reasoner"
        }
      }
    },
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      },
      "models": {
        "~anthropic/claude-sonnet-latest": {
          "name": "Claude Sonnet (OpenRouter)"
        },
        "~google/gemini-flash-latest": {
          "name": "Gemini Flash (OpenRouter)"
        }
      }
    },
    "google": {
      "options": {
        "apiKey": "{env:GOOGLE_GENERATIVE_AI_API_KEY}"
      },
      "models": {
        "gemini-3.5-flash": {
          "name": "Gemini 3.5 Flash"
        },
        "gemini-3-flash": {
          "name": "Gemini 3 Flash"
        },
        "gemini-3-pro": {
          "name": "Gemini 3 Pro"
        }
      }
    },
    "zai": {
      "options": {
        "apiKey": "{env:ZAI_API_KEY}"
      },
      "models": {
        "glm-5.3-flash": {
          "name": "GLM 5.3 Flash"
        },
        "glm-5.3": {
          "name": "GLM 5.3"
        }
      }
    }
  },
  "permission": {
    "mcp-gateway_*": "deny",
    "mcp-gateway_execute_run_configuration": "ask",
    "mcp-gateway_analyze_calls": "allow",
    "mcp-gateway_build_project": "allow",
    "mcp-gateway_fetch_query_result": "allow",
    "mcp-gateway_generate_*": "allow",
    "mcp-gateway_get_*": "allow",
    "mcp-gateway_git_status": "allow",
    "mcp-gateway_introspect_schema": "allow",
    "mcp-gateway_lint_files": "allow",
    "mcp-gateway_list_*": "allow",
    "mcp-gateway_open_file_in_editor": "allow",
    "mcp-gateway_preview_table_data": "allow",
    "mcp-gateway_read*": "allow",
    "mcp-gateway_run_inspection_kts": "allow",
    "mcp-gateway_search_*": "allow",
    "mcp-gateway_test_database_connection": "allow",
    "mcp-gateway_validate_inspection_kts": "allow",
    "mcp-gateway_xdebug_get_*": "allow",
    "mcp-gateway_xdebug_list_*": "allow"
  }
}