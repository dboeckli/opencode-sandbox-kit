<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0">
  <!--
    Sandbox-Maven-Settings (Kit files/home, statisch).

    Maven muss durch den Sandbox-Proxy routen (<proxies> gateway.docker.internal:3128),
    damit die Credential-Injection greifen kann. Der Server 'github' referenziert
    ${env.GITHUB_MAVEN_TOKEN} (proxy-managed Sentinel) — der Proxy ersetzt den
    Platzhalter transparent bei Requests an maven.pkg.github.com.

    Ein read-only Host-Maven-Cache-Mount (/c/Users/*/.m2/repository, /c/*/maven-repo,
    /c/*/m2-repository) wird NICHT statisch abgebildet: der setup.startup-Hook der
    spec.yaml ergänzt dann das aktive Profil 'host-m2-cache' (file://, snapshots disabled).
  -->
  <proxies>
    <proxy>
      <id>sbx-proxy</id>
      <active>true</active>
      <protocol>http</protocol>
      <host>gateway.docker.internal</host>
      <port>3128</port>
      <nonProxyHosts>localhost|127.0.0.1|::1</nonProxyHosts>
    </proxy>
  </proxies>
  <servers>
    <server>
      <id>github</id>
      <username>dboeckli</username>
      <password>${env.GITHUB_MAVEN_TOKEN}</password>
    </server>
  </servers>
</settings>
