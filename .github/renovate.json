{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboardHeader": "**Renovate report** (readable Dependency Dashboard, ersetzt das Mend-GUI). Listet alle erkannten Dependencies und offenen Updates. Fehlen Updates für GitHub-Dependencies, im Abschnitt `Repository Problems` nachsehen (fehlender GitHub-Token).",
  "packageRules": [
    {
      "description": "Helm 4 (`helm`): nur v4-Linie",
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["helm/helm"],
      "matchCurrentValue": "/^4\\./",
      "allowedVersions": "/^4\\./"
    },
    {
      "description": "Liberica JDK: nur LTS-Releases (8/11/17/21/25), analog workarounds:javaLTSVersions",
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["bell-sw/Liberica"],
      "allowedVersions": "/^(?:8|11|17|21|25)(?:\\.|-|$)/"
    },
    {
      "description": "Mistral-Vibe-Pin (Dockerfile ARG VIBE_VERSION + spec-Image-Tag) gemeinsam aktualisieren",
      "matchDatasources": ["pypi"],
      "matchPackageNames": ["mistral-vibe"],
      "groupName": "mistral-vibe"
    },
    {
      "description": "Mammouth-Pin (Dockerfile ARG MAMMOUTH_VERSION + spec imageTag.default) gemeinsam aktualisieren",
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["mammouth-ai/code"],
      "groupName": "mammouth"
    },
    {
      "description": "opencode-docker-Pin in EINEM PR gruppieren: TEMPLATE_VERSION_OPENCODE in validate.yml/e2e.yml + local-test-kits.py sowie die Dockerfile-ARG-BASE_IMAGE-Pins von opencode-agent/opencode und mammouth-agent. Bewusst NICHT mit claude-code-docker gruppiert: Docker veroeffentlicht die Familien nicht mehr in Lockstep (Issue #202)",
      "matchDatasources": ["docker"],
      "matchDepNames": ["sandbox-templates-opencode"],
      "groupName": "sandbox-templates-opencode"
    },
    {
      "description": "claude-code-docker-Pin in EINEM PR gruppieren: TEMPLATE_VERSION_CLAUDE in validate.yml/e2e.yml + local-test-kits.py + Dockerfile ARG BASE_IMAGE (opencode-agent/claude)",
      "matchDatasources": ["docker"],
      "matchDepNames": ["sandbox-templates-claude"],
      "groupName": "sandbox-templates-claude"
    },
    {
      "description": "shell-docker-Pin (Mistral Vibe) in EINEM PR gruppieren: Dockerfile ARG BASE_IMAGE (mistral-vibe-agent)",
      "matchDatasources": ["docker"],
      "matchDepNames": ["sandbox-templates-shell"],
      "groupName": "sandbox-templates-shell"
    },
    {
      "description": "Kubernetes MCP server: host-side install instructions in the PR body (binary is installed on the Windows host, not part of the sandbox image)",
      "matchDatasources": ["github-releases"],
      "matchDepNames": ["containers/kubernetes-mcp-server"],
      "prBodyNotes": [
        "### Host installation required",
        "This update only changes the default of `local-scripts/install-kubernetes-mcp-server.ps1`; the binary is installed on the Windows host.",
        "",
        "1. Switch the kit checkout locally to this PR's branch (the new default only exists there until merge):",
        "   ```powershell",
        "   git fetch origin && git switch renovate/containers-kubernetes-mcp-server-0.x",
        "   ```",
        "2. Stop the running server (Windows locks the `.exe`): `Get-Process kubernetes-mcp-server -ErrorAction SilentlyContinue | Stop-Process`",
        "3. Install: `.\\local-scripts\\install-kubernetes-mcp-server.ps1`",
        "4. Verify: `& \"$env:USERPROFILE\\.local\\bin\\kubernetes-mcp-server.exe\" --version` -> `v{{{newValue}}}`",
        "5. Restart the sandbox/session so the sbx MCP gateway spawns the new binary, then `git switch master`.",
        "",
        "Alternative without switching branches: run the script on `master` with `-Version v{{{newValue}}}`."
      ]
    },
    {
      "description": "Docker MCP server: host-side re-registration instructions in the PR body (runs on the Windows host via uvx, not part of the sandbox image)",
      "matchDatasources": ["pypi"],
      "matchDepNames": ["mcp-server-docker"],
      "prBodyNotes": [
        "### Host re-registration required",
        "This pin only changes the documented/registered version; the server runs on the Windows host via `uvx`.",
        "",
        "1. Re-register the server on the host (PowerShell):",
        "   ```powershell",
        "   sbx mcp rm docker",
        "   sbx mcp add docker --command (Get-Command uvx).Source --args \"mcp-server-docker=={{{newValue}}}\"",
        "   ```",
        "2. Running sandboxes: `sbx mcp load docker --sandbox <name>` (or recreate the sandbox).",
        "3. Verify: `sbx mcp ls` / `sbx mcp inspect docker` shows `mcp-server-docker=={{{newValue}}}`.",
        "",
        "`uvx` downloads the pinned version on first start; there is no local install script for this server."
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Liberica JDK version (install-tooling.sh, alle Kit-Kopien)",
      "managerFilePatterns": ["opencode-agent/files/home/.local/bin/install-tooling.sh", "mammouth-agent/files/home/.local/bin/install-tooling.sh", "mistral-vibe-agent/files/home/.local/bin/install-tooling.sh"],
      "matchStrings": ["LIBERICA_VER=\"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+\\+[0-9]+)\""],
      "depNameTemplate": "bell-sw/Liberica",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "description": "Apache Maven version (install-tooling.sh, alle Kit-Kopien)",
      "managerFilePatterns": ["opencode-agent/files/home/.local/bin/install-tooling.sh", "mammouth-agent/files/home/.local/bin/install-tooling.sh", "mistral-vibe-agent/files/home/.local/bin/install-tooling.sh"],
      "matchStrings": ["MAVEN_VER=\"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "depNameTemplate": "org.apache.maven:apache-maven",
      "datasourceTemplate": "maven"
    },
    {
      "customType": "regex",
      "description": "Docker CLI version (install-tooling.sh, alle Kit-Kopien)",
      "managerFilePatterns": ["opencode-agent/files/home/.local/bin/install-tooling.sh", "mammouth-agent/files/home/.local/bin/install-tooling.sh", "mistral-vibe-agent/files/home/.local/bin/install-tooling.sh"],
      "matchStrings": ["DOCKER_VER=\"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "depNameTemplate": "docker/cli",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Docker Compose plugin version (install-tooling.sh, alle Kit-Kopien)",
      "managerFilePatterns": ["opencode-agent/files/home/.local/bin/install-tooling.sh", "mammouth-agent/files/home/.local/bin/install-tooling.sh", "mistral-vibe-agent/files/home/.local/bin/install-tooling.sh"],
      "matchStrings": ["COMPOSE_VER=\"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "depNameTemplate": "docker/compose",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Helm 4 version (install-tooling.sh, alle Kit-Kopien) — einziges Binary `helm`, siehe packageRules",
      "managerFilePatterns": ["opencode-agent/files/home/.local/bin/install-tooling.sh", "mammouth-agent/files/home/.local/bin/install-tooling.sh", "mistral-vibe-agent/files/home/.local/bin/install-tooling.sh"],
      "matchStrings": ["HELM_VER=\"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "depNameTemplate": "helm/helm",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Node.js version (install-tooling.sh, alle Kit-Kopien) — node-version-Datasource + node-Versioning ⇒ LTS-Awareness: Current-Majors (z. B. 26) werden erst ab ihrem LTS-Termin vorgeschlagen; npm CLIs (renovate >=43) benötigen Node ^24.11",
      "managerFilePatterns": ["opencode-agent/files/home/.local/bin/install-tooling.sh", "mammouth-agent/files/home/.local/bin/install-tooling.sh", "mistral-vibe-agent/files/home/.local/bin/install-tooling.sh"],
      "matchStrings": ["NODE_VER=\"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version"
    },
    {
      "customType": "regex",
      "description": "shfmt version (install-tooling.sh, alle Kit-Kopien)",
      "managerFilePatterns": ["opencode-agent/files/home/.local/bin/install-tooling.sh", "mammouth-agent/files/home/.local/bin/install-tooling.sh", "mistral-vibe-agent/files/home/.local/bin/install-tooling.sh"],
      "matchStrings": ["SHFMT_VER=\"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "depNameTemplate": "mvdan/sh",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Apache Kafka distribution version (install-tooling.sh, alle Kit-Kopien). Quelle = die distro-Verzeichnisliste auf dlcdn (custom Datasource `custom.apache-kafka`), NICHT Maven Central: die Maven-Artifacts (org.apache.kafka:kafka_2.13) werden publiziert, bevor der Binary-Tarball auf den Apache-Mirrors liegt — ein Maven-Bump auf eine noch nicht veröffentlichte Distro bricht den Image-Build.",
      "managerFilePatterns": ["opencode-agent/files/home/.local/bin/install-tooling.sh", "mammouth-agent/files/home/.local/bin/install-tooling.sh", "mistral-vibe-agent/files/home/.local/bin/install-tooling.sh"],
      "matchStrings": ["KAFKA_VER=\"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "depNameTemplate": "apache/kafka",
      "datasourceTemplate": "custom.apache-kafka",
      "extractVersionTemplate": "^(?<version>[0-9]+\\.[0-9]+\\.[0-9]+)/?$",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "sbx CLI version (.github/workflows/e2e.yml, validate.yml)",
      "managerFilePatterns": [".github/workflows/e2e.yml", ".github/workflows/validate.yml", ".forgejo/workflows/e2e.yml", ".forgejo/workflows/validate.yml"],
      "matchStrings": ["SBX_VERSION: v?(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"],
      "depNameTemplate": "docker/sbx-releases",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "opencode-docker-Pin (.github/workflows/e2e.yml, validate.yml: TEMPLATE_VERSION_OPENCODE) — getrennt von claude-code-docker (Issue #202)",
      "managerFilePatterns": [".github/workflows/e2e.yml", ".github/workflows/validate.yml", ".forgejo/workflows/e2e.yml", ".forgejo/workflows/validate.yml"],
      "matchStrings": ["TEMPLATE_VERSION_OPENCODE: (?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"],
      "depNameTemplate": "sandbox-templates-opencode",
      "packageNameTemplate": "docker/sandbox-templates",
      "datasourceTemplate": "docker",
      "extractVersionTemplate": "^opencode-docker-(?<version>.*)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "claude-code-docker-Pin (.github/workflows/e2e.yml, validate.yml: TEMPLATE_VERSION_CLAUDE) — getrennt von opencode-docker (Issue #202)",
      "managerFilePatterns": [".github/workflows/e2e.yml", ".github/workflows/validate.yml", ".forgejo/workflows/e2e.yml", ".forgejo/workflows/validate.yml"],
      "matchStrings": ["TEMPLATE_VERSION_CLAUDE: (?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"],
      "depNameTemplate": "sandbox-templates-claude",
      "packageNameTemplate": "docker/sandbox-templates",
      "datasourceTemplate": "docker",
      "extractVersionTemplate": "^claude-code-docker-(?<version>.*)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "opencode-docker-Pin (local-test-kits.py TEMPLATE_VERSION_OPENCODE-Konstante; muss mit validate.yml/e2e.yml + den Dockerfile-Base-Pins uebereinstimmen)",
      "managerFilePatterns": ["local-test/local-test-kits.py"],
      "matchStrings": ["TEMPLATE_VERSION_OPENCODE = \"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "depNameTemplate": "sandbox-templates-opencode",
      "packageNameTemplate": "docker/sandbox-templates",
      "datasourceTemplate": "docker",
      "extractVersionTemplate": "^opencode-docker-(?<version>.*)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "claude-code-docker-Pin (local-test-kits.py TEMPLATE_VERSION_CLAUDE-Konstante; muss mit validate.yml/e2e.yml + dem Dockerfile-Base-Pin uebereinstimmen)",
      "managerFilePatterns": ["local-test/local-test-kits.py"],
      "matchStrings": ["TEMPLATE_VERSION_CLAUDE = \"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "depNameTemplate": "sandbox-templates-claude",
      "packageNameTemplate": "docker/sandbox-templates",
      "datasourceTemplate": "docker",
      "extractVersionTemplate": "^claude-code-docker-(?<version>.*)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "opencode-docker-Pin (mammouth-agent/Dockerfile ARG BASE_IMAGE=docker/sandbox-templates:opencode-docker-<v>; muss TEMPLATE_VERSION_OPENCODE spiegeln)",
      "managerFilePatterns": ["mammouth-agent/Dockerfile"],
      "matchStrings": ["ARG BASE_IMAGE=docker/sandbox-templates:opencode-docker-(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"],
      "depNameTemplate": "sandbox-templates-opencode",
      "packageNameTemplate": "docker/sandbox-templates",
      "datasourceTemplate": "docker",
      "extractVersionTemplate": "^opencode-docker-(?<version>.*)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Mammouth CLI version (mammouth-agent/Dockerfile ARG MAMMOUTH_VERSION; github-releases mammouth-ai/code) — spec-Image-Tag wird per packageRule mitgruppiert",
      "managerFilePatterns": ["mammouth-agent/Dockerfile"],
      "matchStrings": ["ARG MAMMOUTH_VERSION=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+)"],
      "depNameTemplate": "mammouth-ai/code",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "versioningTemplate": "maven"
    },
    {
      "customType": "regex",
      "description": "Mammouth image tag (mammouth-agent/spec.yaml args.imageTag.default; Mirror des Dockerfile-Pins)",
      "managerFilePatterns": ["mammouth-agent/spec.yaml"],
      "matchStrings": ["imageTag:\\s*\\n\\s+default: \"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "depNameTemplate": "mammouth-ai/code",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "versioningTemplate": "maven"
    },
    {
      "customType": "regex",
      "description": "Mistral Vibe version (mistral-vibe-agent/Dockerfile ARG VIBE_VERSION; PyPI) — spec-Image-Tag wird per packageRule mitgruppiert",
      "managerFilePatterns": ["mistral-vibe-agent/Dockerfile"],
      "matchStrings": ["ARG VIBE_VERSION=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"],
      "depNameTemplate": "mistral-vibe",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "Mistral Vibe image tag (mistral-vibe-agent/spec.yaml args.imageTag.default; Mirror des Dockerfile-Pins)",
      "managerFilePatterns": ["mistral-vibe-agent/spec.yaml"],
      "matchStrings": ["imageTag:\\s*\\n\\s+default: \"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "depNameTemplate": "mistral-vibe",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "shell-docker-Pin (mistral-vibe-agent/Dockerfile ARG BASE_IMAGE=docker/sandbox-templates:shell-docker-<v>; eigener Pin, unabhaengig von opencode/claude)",
      "managerFilePatterns": ["mistral-vibe-agent/Dockerfile"],
      "matchStrings": ["ARG BASE_IMAGE=docker/sandbox-templates:shell-docker-(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"],
      "depNameTemplate": "sandbox-templates-shell",
      "packageNameTemplate": "docker/sandbox-templates",
      "datasourceTemplate": "docker",
      "extractVersionTemplate": "^shell-docker-(?<version>.*)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "opencode-docker-Pin (opencode-agent/opencode/Dockerfile ARG BASE_IMAGE=docker/sandbox-templates:opencode-docker-<v>; muss TEMPLATE_VERSION_OPENCODE spiegeln)",
      "managerFilePatterns": ["opencode-agent/opencode/Dockerfile"],
      "matchStrings": ["ARG BASE_IMAGE=docker/sandbox-templates:opencode-docker-(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"],
      "depNameTemplate": "sandbox-templates-opencode",
      "packageNameTemplate": "docker/sandbox-templates",
      "datasourceTemplate": "docker",
      "extractVersionTemplate": "^opencode-docker-(?<version>.*)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "claude-code-docker-Pin (opencode-agent/claude/Dockerfile ARG BASE_IMAGE=docker/sandbox-templates:claude-code-docker-<v>; muss TEMPLATE_VERSION_CLAUDE spiegeln)",
      "managerFilePatterns": ["opencode-agent/claude/Dockerfile"],
      "matchStrings": ["ARG BASE_IMAGE=docker/sandbox-templates:claude-code-docker-(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"],
      "depNameTemplate": "sandbox-templates-claude",
      "packageNameTemplate": "docker/sandbox-templates",
      "datasourceTemplate": "docker",
      "extractVersionTemplate": "^claude-code-docker-(?<version>.*)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Kubernetes MCP server version (local-scripts/install-kubernetes-mcp-server.ps1 host install script, pinned -Version default; not part of the sandbox image)",
      "managerFilePatterns": ["local-scripts/install-kubernetes-mcp-server.ps1"],
      "matchStrings": ["\\[string\\]\\$Version = \"v(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "depNameTemplate": "containers/kubernetes-mcp-server",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Lokaler Docker-MCP-Server (mcp-server-docker, Drittanbieter) Pin in Doku + README (docs/docker-mcp-server.md, README.md, Issue #165; host-seitig via uvx registriert)",
      "managerFilePatterns": ["docs/docker-mcp-server.md", "README.md"],
      "matchStrings": ["mcp-server-docker==(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"],
      "depNameTemplate": "mcp-server-docker",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "Bruno CLI (@usebruno/cli) Pin — setup.install in allen drei Kit-Specs + npm-global CLIs in den Tooling-Images (opencode/claude/mammouth Dockerfile); Issue #257 im spring-6-gateway-Repo",
      "managerFilePatterns": ["opencode-agent/spec.yaml", "mammouth-agent/spec.yaml", "mistral-vibe-agent/spec.yaml", "opencode-agent/opencode/Dockerfile", "opencode-agent/claude/Dockerfile", "mammouth-agent/Dockerfile"],
      "matchStrings": ["@usebruno/cli@(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"],
      "depNameTemplate": "@usebruno/cli",
      "datasourceTemplate": "npm"
    }
  ],
  "customDatasources": {
    "apache-kafka": {
      "defaultRegistryUrlTemplate": "https://dlcdn.apache.org/kafka/",
      "format": "html"
    }
  }
}