{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "github-actions": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Helm v3 (Default `helm`): nur v3-Linie",
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["helm/helm"],
      "matchCurrentValue": "/^3\\./",
      "allowedVersions": "/^3\\./"
    },
    {
      "description": "Helm v4 (`helm4`): v4-Linie des parallelen Binaries",
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["helm/helm"],
      "matchCurrentValue": "/^4\\./",
      "allowedVersions": "/^4\\./"
    },
    {
      "description": "Liberica JDK: nur LTS-Releases (8/11/17/21/25), analog workarounds:javaLTSVersions",
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["bell-sw/Liberica"],
      "allowedVersions": "/^(?:8|11|17|21|25)(?:\\.|-|$)/"
    },
    {
      "description": "Mistral-Vibe-Pin (Dockerfile ARG VIBE_VERSION + spec-Image-Tag) gemeinsam aktualisieren",
      "matchDatasources": ["pypi"],
      "matchPackageNames": ["mistral-vibe"],
      "groupName": "mistral-vibe"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Liberica JDK version (install-tooling.sh, alle Kit-Kopien)",
      "managerFilePatterns": ["opencode-agent/files/home/.local/bin/install-tooling.sh", "mammouth-agent/files/home/.local/bin/install-tooling.sh", "mistral-vibe-agent/files/home/.local/bin/install-tooling.sh"],
      "matchStrings": ["LIBERICA_VER=\"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+\\+[0-9]+)\""],
      "depNameTemplate": "bell-sw/Liberica",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "description": "Apache Maven version (install-tooling.sh, alle Kit-Kopien)",
      "managerFilePatterns": ["opencode-agent/files/home/.local/bin/install-tooling.sh", "mammouth-agent/files/home/.local/bin/install-tooling.sh", "mistral-vibe-agent/files/home/.local/bin/install-tooling.sh"],
      "matchStrings": ["MAVEN_VER=\"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "depNameTemplate": "org.apache.maven:apache-maven",
      "datasourceTemplate": "maven"
    },
    {
      "customType": "regex",
      "description": "Docker CLI version (install-tooling.sh, alle Kit-Kopien)",
      "managerFilePatterns": ["opencode-agent/files/home/.local/bin/install-tooling.sh", "mammouth-agent/files/home/.local/bin/install-tooling.sh", "mistral-vibe-agent/files/home/.local/bin/install-tooling.sh"],
      "matchStrings": ["DOCKER_VER=\"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "depNameTemplate": "docker/cli",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Docker Compose plugin version (install-tooling.sh, alle Kit-Kopien)",
      "managerFilePatterns": ["opencode-agent/files/home/.local/bin/install-tooling.sh", "mammouth-agent/files/home/.local/bin/install-tooling.sh", "mistral-vibe-agent/files/home/.local/bin/install-tooling.sh"],
      "matchStrings": ["COMPOSE_VER=\"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "depNameTemplate": "docker/compose",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Helm v3 version (install-tooling.sh, alle Kit-Kopien) — Default `helm`, siehe packageRules",
      "managerFilePatterns": ["opencode-agent/files/home/.local/bin/install-tooling.sh", "mammouth-agent/files/home/.local/bin/install-tooling.sh", "mistral-vibe-agent/files/home/.local/bin/install-tooling.sh"],
      "matchStrings": ["HELM_VER=\"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "depNameTemplate": "helm/helm",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Helm v4 version (install-tooling.sh, alle Kit-Kopien) — paralleles Binary `helm4`, siehe packageRules",
      "managerFilePatterns": ["opencode-agent/files/home/.local/bin/install-tooling.sh", "mammouth-agent/files/home/.local/bin/install-tooling.sh", "mistral-vibe-agent/files/home/.local/bin/install-tooling.sh"],
      "matchStrings": ["HELM4_VER=\"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "depNameTemplate": "helm/helm",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "shfmt version (install-tooling.sh, alle Kit-Kopien)",
      "managerFilePatterns": ["opencode-agent/files/home/.local/bin/install-tooling.sh", "mammouth-agent/files/home/.local/bin/install-tooling.sh", "mistral-vibe-agent/files/home/.local/bin/install-tooling.sh"],
      "matchStrings": ["SHFMT_VER=\"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "depNameTemplate": "mvdan/sh",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Apache Kafka distribution version (install-tooling.sh, alle Kit-Kopien; Version = Maven-Central-Artifact org.apache.kafka:kafka_2.13)",
      "managerFilePatterns": ["opencode-agent/files/home/.local/bin/install-tooling.sh", "mammouth-agent/files/home/.local/bin/install-tooling.sh", "mistral-vibe-agent/files/home/.local/bin/install-tooling.sh"],
      "matchStrings": ["KAFKA_VER=\"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "depNameTemplate": "org.apache.kafka:kafka_2.13",
      "datasourceTemplate": "maven"
    },
    {
      "customType": "regex",
      "description": "sbx CLI version (.github/workflows/e2e.yml, validate.yml)",
      "managerFilePatterns": [".github/workflows/e2e.yml", ".github/workflows/validate.yml"],
      "matchStrings": ["SBX_VERSION: v?(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"],
      "depNameTemplate": "docker/sbx-releases",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Sandbox-Template-Version (.github/workflows/e2e.yml, validate.yml; TEMPLATE_VERSION gilt fuer opencode-docker + claude-code-docker, --template-Pins in Start-Commands/README + Mammouth-spec-Image)",
      "managerFilePatterns": [".github/workflows/e2e.yml", ".github/workflows/validate.yml"],
      "matchStrings": ["TEMPLATE_VERSION: (?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"],
      "depNameTemplate": "docker/sandbox-templates",
      "datasourceTemplate": "docker",
      "extractVersionTemplate": "^(?:opencode-docker|claude-code-docker)-(?<version>.*)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Sandbox-Template-Version (local-test-kits.py, expliziter Pin der lokalen Tests; muss mit validate.yml/e2e.yml + Mammouth-spec-Image uebereinstimmen)",
      "managerFilePatterns": ["local-test/local-test-kits.py"],
      "matchStrings": ["TEMPLATE_VERSION = \"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "depNameTemplate": "docker/sandbox-templates",
      "datasourceTemplate": "docker",
      "extractVersionTemplate": "^(?:opencode-docker|claude-code-docker)-(?<version>.*)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Sandbox-Template-Version (mammouth-agent/spec.yaml sandbox.image, opencode-docker Mirror; muss TEMPLATE_VERSION spiegeln)",
      "managerFilePatterns": ["mammouth-agent/spec.yaml"],
      "matchStrings": ["image:\\s*\"docker/sandbox-templates:opencode-docker-(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "depNameTemplate": "docker/sandbox-templates",
      "datasourceTemplate": "docker",
      "extractVersionTemplate": "^(?:opencode-docker|claude-code-docker)-(?<version>.*)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Sandbox-Template-Version in der Doku (konkrete sbx --template-Image-Refs in MD-Files; Prosa bleibt versionsneutral als 0.x.0). Das OpenCode-Tooling-Image traegt denselben Basis-Versions-Tag (opencode-docker)",
      "managerFilePatterns": ["README.md", "AGENTS.md", "INSTALL.md", "docs/kubernetes-integration.md"],
      "matchStrings": ["docker/sandbox-templates:(?:opencode-docker|claude-code-docker|shell-docker)-(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)", "domboeckli/sbx-opencode-tooling:(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"],
      "depNameTemplate": "docker/sandbox-templates",
      "datasourceTemplate": "docker",
      "extractVersionTemplate": "^(?:opencode-docker|claude-code-docker|shell-docker)-(?<version>.*)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Mammouth CLI version (mammouth-agent/spec.yaml install.sh-VERSION, `VERSION=<v> bash`)",
      "managerFilePatterns": ["mammouth-agent/spec.yaml"],
      "matchStrings": ["install\\.sh \\| VERSION=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+) bash"],
      "depNameTemplate": "mammouth-ai/code",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "versioningTemplate": "maven"
    },
    {
      "customType": "regex",
      "description": "Mistral Vibe version (mistral-vibe-agent/Dockerfile ARG VIBE_VERSION; PyPI) — spec-Image-Tag wird per packageRule mitgruppiert",
      "managerFilePatterns": ["mistral-vibe-agent/Dockerfile"],
      "matchStrings": ["ARG VIBE_VERSION=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"],
      "depNameTemplate": "mistral-vibe",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "Mistral Vibe image tag (mistral-vibe-agent/spec.yaml args.imageTag.default; Mirror des Dockerfile-Pins)",
      "managerFilePatterns": ["mistral-vibe-agent/spec.yaml"],
      "matchStrings": ["imageTag:\\s*\\n\\s+default: \"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "depNameTemplate": "mistral-vibe",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "Mistral Vibe Basis-Template (mistral-vibe-agent/Dockerfile ARG BASE_IMAGE=docker/sandbox-templates:shell-docker-<v>; muss TEMPLATE_VERSION spiegeln)",
      "managerFilePatterns": ["mistral-vibe-agent/Dockerfile"],
      "matchStrings": ["ARG BASE_IMAGE=docker/sandbox-templates:shell-docker-(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"],
      "depNameTemplate": "docker/sandbox-templates",
      "datasourceTemplate": "docker",
      "extractVersionTemplate": "^shell-docker-(?<version>.*)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "OpenCode Tooling-Image Basis-Template (opencode-agent/Dockerfile ARG BASE_IMAGE=docker/sandbox-templates:opencode-docker-<v>; muss TEMPLATE_VERSION spiegeln)",
      "managerFilePatterns": ["opencode-agent/Dockerfile"],
      "matchStrings": ["ARG BASE_IMAGE=docker/sandbox-templates:opencode-docker-(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"],
      "depNameTemplate": "docker/sandbox-templates",
      "datasourceTemplate": "docker",
      "extractVersionTemplate": "^opencode-docker-(?<version>.*)$",
      "versioningTemplate": "semver"
    }
  ]
}