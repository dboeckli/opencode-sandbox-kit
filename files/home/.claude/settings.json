{
  "model": "claude-sonnet-4-6",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "mcpServers": {
    "idea": {
      "type": "sse",
      "url": "http://host.docker.internal:64342/sse"
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.config/sandbox-kit/run-checks-hook.sh"
          }
        ]
      }
    ]
  }
}
